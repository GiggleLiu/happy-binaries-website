---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { sortedIndexPosts } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = sortedIndexPosts(await getCollection('blog'));
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag} — Jin-Guo Liu Group`}>
  <p class="meta"><a href="/blog/">← Blog</a></p>
  <h1>Posts tagged “{tag}”</h1>
  <PostList posts={posts} />
</Base>
